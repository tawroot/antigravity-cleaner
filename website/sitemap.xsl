<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="2.0"
                xmlns:html="http://www.w3.org/TR/REC-html40"
                xmlns:sitemap="http://www.sitemaps.org/schemas/sitemap/0.9"
                xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:output method="html" version="1.0" encoding="UTF-8" indent="yes"/>
  <xsl:template match="/">
    <html lang="en">
      <head>
        <title>XML Sitemap | Antigravity Cleaner</title>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <style>
          :root {
            --bg: #ffffff;
            --bg-soft: #f6f6f7;
            --text-1: #213547;
            --text-2: #64748b;
            --border: rgba(60, 60, 67, 0.12);
            --brand: #2563EB;
            --brand-soft: rgba(37, 99, 235, 0.08);
          }
          @media (prefers-color-scheme: dark) {
            :root {
              --bg: #1e1e20;
              --bg-soft: #252529;
              --text-1: rgba(255, 255, 255, 0.92);
              --text-2: rgba(235, 235, 235, 0.65);
              --border: rgba(84, 84, 88, 0.48);
              --brand: #3B82F6;
              --brand-soft: rgba(59, 130, 246, 0.16);
            }
          }
          body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background: var(--bg);
            color: var(--text-1);
            margin: 0;
            padding: 40px 20px;
            line-height: 1.6;
          }
          .container {
            max-width: 960px;
            margin: 0 auto;
          }
          .header {
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border);
          }
          h1 {
            font-size: 24px;
            font-weight: 800;
            margin: 0 0 8px;
            color: var(--text-1);
            display: flex;
            align-items: center;
            gap: 10px;
          }
          p {
            color: var(--text-2);
            font-size: 14px;
            margin: 0 0 16px;
          }
          .stats {
            display: inline-block;
            background: var(--brand-soft);
            color: var(--brand);
            padding: 4px 12px;
            border-radius: 9999px;
            font-size: 12.5px;
            font-weight: 600;
          }
          table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            font-size: 13.5px;
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: 8px;
            overflow: hidden;
          }
          th {
            background: var(--bg-soft);
            color: var(--text-1);
            text-align: left;
            padding: 12px 16px;
            font-weight: 600;
            border-bottom: 1px solid var(--border);
          }
          td {
            padding: 12px 16px;
            border-bottom: 1px solid var(--border);
          }
          tr:last-child td {
            border-bottom: none;
          }
          tr:hover td {
            background: var(--bg-soft);
          }
          a {
            color: var(--brand);
            text-decoration: none;
            word-break: break-all;
          }
          a:hover {
            text-decoration: underline;
          }
          .priority-bar {
            display: inline-block;
            height: 6px;
            border-radius: 3px;
            background: var(--brand);
            margin-right: 8px;
            vertical-align: middle;
          }
          .footer {
            margin-top: 40px;
            text-align: center;
            font-size: 12.5px;
            color: var(--text-2);
          }
        </style>
      </head>
      <body>
        <div class="container">
          <div class="header">
            <h1>XML Sitemap</h1>
            <p>Generated by Antigravity Cleaner. Formatted for search engine indexing and human discovery.</p>
            <div class="stats">Total Indexed URLs: <xsl:value-of select="count(sitemap:urlset/sitemap:url)"/></div>
          </div>
          <table>
            <thead>
              <tr>
                <th style="width: 55%;">URL</th>
                <th style="width: 15%;">Priority</th>
                <th style="width: 15%;">Change Frequency</th>
                <th style="width: 15%;">Last Modified</th>
              </tr>
            </thead>
            <tbody>
              <xsl:for-each select="sitemap:urlset/sitemap:url">
                <tr>
                  <td>
                    <a href="{sitemap:loc}"><xsl:value-of select="sitemap:loc"/></a>
                  </td>
                  <td>
                    <span class="priority-bar" style="width: {sitemap:priority * 40}px;"></span>
                    <xsl:value-of select="sitemap:priority"/>
                  </td>
                  <td><xsl:value-of select="sitemap:changefreq"/></td>
                  <td><xsl:value-of select="sitemap:lastmod"/></td>
                </tr>
              </xsl:for-each>
            </tbody>
          </table>
          <div class="footer">
            Antigravity Cleaner Project • <a href="https://github.com/tawroot/antigravity-cleaner">GitHub Repository</a> • Apache-2.0
          </div>
        </div>
      </body>
    </html>
  </xsl:template>
</xsl:stylesheet>
